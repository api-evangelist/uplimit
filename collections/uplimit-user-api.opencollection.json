        {
          "info": {
            "name": "POST /v1/CreateUser",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://uplimit.com/api/organization/v1/CreateUser",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This API creates a new user account on Uplimit and enrolls the user into your organization. If a user account with the same email already exists, we will just enroll that existing user into your organization. "
        },
        {
          "info": {
            "name": "POST /v1/EnrollUserIntoSession",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://uplimit.com/api/organization/v1/EnrollUserIntoSession",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This API allows developers to add a user into a session. The user must have already been created with the Create User API (see above) before you can add this user."
        },
        {
          "info": {
            "name": "POST /v1/EnrollUserIntoCourse",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://uplimit.com/api/organization/v1/EnrollUserIntoCourse",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This API allows developers to add a user into a course. The user must have already been created with the Create User API (see above) before you can add this user. In general, prefer to use the EnrollUserIntoSession API instead of this API, because that is more specific and you can specify the exact session you want to enroll the user into, instead of relying on a policy."
        },
